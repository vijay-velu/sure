<script>
  if (localStorage.theme === 'dark' || localStorage.theme === 'oled' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.setAttribute("data-theme", "dark");
  }
  if (localStorage.theme === 'oled') {
    document.documentElement.setAttribute("data-oled", "");
  }
</script>
