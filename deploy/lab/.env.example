# Public URL your reverse proxy serves Sure on (used for OIDC redirect + WebAuthn).
APP_HOST=sure.otxlab.net

# OIDC (Authentik / Authelia / Keycloak / NetIQ AA). Client secret lives in secrets/oidc_client_secret.
OIDC_ISSUER=https://auth.otxlab.net/application/o/sure/
OIDC_CLIENT_ID=sure
OIDC_BUTTON_LABEL=Sign in with SSO
# REQUIRED. Email domains allowed to sign in via SSO. Make sure your IdP only issues verified emails.
ALLOWED_OIDC_DOMAINS=otxlab.net
# link_only (default): SSO never creates users. Set create_and_link for your first login, then remove.
# AUTH_JIT_MODE=create_and_link
# After bootstrapping your admin via SSO, set to false to force SSO-only login.
AUTH_LOCAL_LOGIN_ENABLED=true

# Email for bill reminders (Settings -> Notifications). Password goes in secrets/smtp_password.
# SMTP_ADDRESS=smtp.otxlab.net
# SMTP_PORT=587
# SMTP_USERNAME=sure@otxlab.net
# EMAIL_SENDER=sure@otxlab.net
